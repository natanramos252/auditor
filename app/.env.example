# Copie para .env (cp .env.example .env). Nenhum valor secreto vem preenchido neste projeto.

# ---- IA ----------------------------------------------------------------------------------------
# Padrão: IA via freellmapi, que já sobe junto no docker compose (http://localhost:3001).
# Passos: abra o painel, adicione as SUAS chaves de provedores gratuitos, gere a chave do gateway
# e cole abaixo. Enquanto OPENAI_API_KEY estiver vazia, o auditor roda em modo sem IA.
LLM_PROVIDER=openai
OPENAI_BASE_URL=http://freellmapi:3001/v1
LLM_MODEL=auto
OPENAI_API_KEY=

# Alternativas (troque LLM_PROVIDER e preencha o que for usar):
#   anthropic -> ANTHROPIC_API_KEY=...   (LLM_MODEL opcional, ex.: claude-sonnet-5-5)
#   ollama    -> OLLAMA_URL=http://host.docker.internal:11434  (modelo local; LLM_MODEL=phi3.5:latest)
#   mock      -> sem IA, só busca por palavras
ANTHROPIC_API_KEY=
OLLAMA_URL=http://host.docker.internal:11434
# Servidor compatível com OpenAI que não exige chave (LM Studio, vLLM): OPENAI_ALLOW_NO_KEY=1
OPENAI_ALLOW_NO_KEY=

# IAs gratuitas têm limite de uso: 1 chamada por vez evita erros 429.
LLM_CONCURRENCY=1

# ---- Instalação --------------------------------------------------------------------------------
WEB_PORT=8080
FREELLMAPI_PORT=3001
# Senha do banco interno (opcional; o banco não é exposto fora do compose)
POSTGRES_PASSWORD=
# Chave de criptografia do freellmapi (opcional; se vazia, é gerada no volume na primeira execução)
ENCRYPTION_KEY=
# Quem responde por esta instalação (aparece nos termos de uso)
OPERATOR_NAME=
OPERATOR_CONTACT=
